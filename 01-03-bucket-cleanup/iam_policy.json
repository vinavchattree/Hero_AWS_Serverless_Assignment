{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "S3BucketCleanupPermissions",
			"Effect": "Allow",
			"Action": [
				"s3:ListBucket"
			],
			"Resource": "arn:aws:s3:::learn-cli-vinav"
		},
		{
			"Sid": "S3ObjectDeletePermissions",
			"Effect": "Allow",
			"Action": [
				"s3:DeleteObject"
			],
			"Resource": "arn:aws:s3:::learn-cli-vinav/*"
		}
	]
}